<?xml version="1.0" encoding="UTF-8"?>
<!--
    The task of the Task Scheduler of Windows.

    It runs one inbox triage pass every hour and writes the structured log of
    the run to the standard output of the task, the errors go to the standard
    error of the task.

    The task does not pass a window: the run looks back to the moment of the
    last successful run, so it looks at every mail exactly once and it never
    misses the mail of an outage.

    Install it as a task of the user:

        schtasks /Create /TN "RecruiterCli" /XML config\task-scheduler\recruiter-cli.xml /F

    The paths of the jar and of the files are the ones of the installation
    described in the README, change them if the installation lives somewhere
    else.
-->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
    <RegistrationInfo>
        <Description>The hourly inbox triage pass of TalentTriage</Description>
        <URI>\RecruiterCli</URI>
    </RegistrationInfo>
    <Triggers>
        <CalendarTrigger>
            <StartBoundary>2026-01-01T00:00:00</StartBoundary>
            <Enabled>true</Enabled>
            <ScheduleByDay>
                <DaysInterval>1</DaysInterval>
            </ScheduleByDay>
            <Repetition>
                <Interval>PT1H</Interval>
                <Duration>P1D</Duration>
                <StopAtDurationEnd>false</StopAtDurationEnd>
            </Repetition>
        </CalendarTrigger>
    </Triggers>
    <Principals>
        <Principal id="Author">
            <LogonType>InteractiveToken</LogonType>
            <RunLevel>LeastPrivilege</RunLevel>
        </Principal>
    </Principals>
    <Settings>
        <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
        <DisallowStartIfOnBatteries>true</DisallowStartIfOnBatteries>
        <StopIfGoingOnBatteries>true</StopIfGoingOnBatteries>
        <StartWhenAvailable>false</StartWhenAvailable>
        <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
        <IdleSettings>
            <StopOnIdleEnd>true</StopOnIdleEnd>
            <RestartOnIdle>false</RestartOnIdle>
        </IdleSettings>
        <AllowStartOnDemand>true</AllowStartOnDemand>
        <Enabled>true</Enabled>
        <Hidden>false</Hidden>
        <RunOnlyIfIdle>false</RunOnlyIfIdle>
        <WakeToRun>false</WakeToRun>
        <ExecutionTimeLimit>PT72H</ExecutionTimeLimit>
        <Priority>7</Priority>
    </Settings>
    <Actions Context="Author">
        <Exec>
            <Command>C:\Program Files\Java\jdk-17\bin\java.exe</Command>
            <Arguments>--enable-native-access=ALL-UNNAMED -jar "C:\recruiter-cli\recruiter-cli.jar" process-inbox --credentials "C:\recruiter-cli\credentials.json" --token "C:\recruiter-cli\token.json" --requirements "C:\recruiter-cli\requirements.json"</Arguments>
            <WorkingDirectory>C:\recruiter-cli</WorkingDirectory>
        </Exec>
    </Actions>
</Task>
